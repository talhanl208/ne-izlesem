# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env asla GitHub'a yüklenmez.

# Zorunlu — https://www.themoviedb.org/settings/api
# "API Read Access Token" (eyJ... ile başlar) önerilir: istek başlığında gider, adres çubuğunda/loglarda görünmez.
# "API Key" (v3) de çalışır.
TMDB_API_KEY=

# İsteğe bağlı — https://www.omdbapi.com/apikey.aspx (ücretsiz, günde 1000 istek)
# Rotten Tomatoes ve Metacritic puanlarını ekler.
OMDB_API_KEY=

# Uzun ve rastgele bir değer yaz. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistir-beni

# PythonAnywhere gibi bir vekil sunucunun arkasında çalışıyorsan 1 yap
# (istek sınırlaması gerçek ziyaretçi IP'sine göre yapılsın diye).
TRUST_PROXY=0

# Kendi kendine bakım (varsayılanlar genelde yeterli)
# AUTO_MAINTENANCE=1
# CACHE_MAX_MB=150
# CLEANUP_INTERVAL_HOURS=6
# IMDB_AUTO_UPDATE_DAYS=30

# İsteğe bağlı ince ayarlar
# RATE_LIMIT=1
# RESULT_LIMIT=20
# CANDIDATE_LIMIT=60
# MAX_WORKERS=8
